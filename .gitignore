# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. The pattern above is unanchored, so without this
# negation .env.example is silently never committed and nobody discovers which
# variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Downloaded/derived media — refetched with scripts/fetch-assets.mjs, not
# versioned. Git will not descend into an excluded directory, so re-opening a
# single file inside it takes the full ladder below rather than one negation.
public/assets/*
!public/assets/img/
public/assets/img/*
# UV's own illustration, supplied by UV rather than downloaded. A fresh clone
# needs it, and nothing can refetch it, so it is versioned.
!public/assets/img/careers-paths.webp

# job applications — personal data (CVs, contact details), never commit
applications/
