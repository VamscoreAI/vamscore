# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. The pattern above is unanchored, so without this
# negation .env.example is silently never committed and nobody discovers which
# variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Downloaded/derived media — refetched with scripts/fetch-assets.mjs, not
# versioned. Git will not descend into an excluded directory, so re-opening a
# single file inside it takes the full ladder below rather than one negation.
public/assets/*
!public/assets/img/
public/assets/img/*
# Supplied by UV rather than downloaded. A fresh clone needs these and nothing
# can refetch them, so they are versioned. Add a line here for every UV-supplied
# image — miss one and it deploys from your machine but 404s for anyone who
# clones. (If this list keeps growing, move them to their own un-ignored
# directory instead.)
!public/assets/img/careers-paths.webp
!public/assets/img/story-tata-channel.webp
!public/assets/img/about-vision.webp
!public/assets/img/about-mission.webp
!public/assets/img/story-jio-network.webp
!public/assets/img/story-jio-partnership.webp
!public/assets/img/story-jio-customer.webp
!public/assets/img/story-topper-practice.webp
!public/assets/img/story-topper-classroom.webp
!public/assets/img/story-topper-demand.webp
!public/assets/img/story-topper-reach.webp
!public/assets/img/story-tata-network.webp
!public/assets/img/story-tata-kyc.webp
!public/assets/img/story-tata-reach.webp

# job applications — personal data (CVs, contact details), never commit
applications/
