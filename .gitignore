# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. The pattern above is unanchored, so without this
# negation .env.example is silently never committed and nobody discovers which
# variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Downloaded/derived media — refetched with scripts/fetch-assets.mjs, not
# versioned. Git will not descend into an excluded directory, so re-opening a
# single file inside it takes the full ladder below rather than one negation.
public/assets/*
!public/assets/img/
public/assets/img/*
# Supplied by UV rather than downloaded. A fresh clone needs these and nothing
# can refetch them, so they are versioned. Add a line here for every UV-supplied
# image — miss one and it deploys from your machine but 404s for anyone who
# clones. (If this list keeps growing, move them to their own un-ignored
# directory instead.)
!public/assets/img/careers-paths.webp
!public/assets/img/story-tata-channel.webp
!public/assets/img/about-vision.webp
!public/assets/img/about-mission.webp
!public/assets/img/story-jio-network.webp
!public/assets/img/story-jio-partnership.webp
!public/assets/img/story-jio-customer.webp
!public/assets/img/story-topper-practice.webp
!public/assets/img/story-topper-classroom.webp
!public/assets/img/story-topper-demand.webp
!public/assets/img/story-topper-reach.webp
!public/assets/img/story-tata-network.webp
!public/assets/img/story-tata-kyc.webp
!public/assets/img/story-tata-reach.webp
!public/assets/img/contact-hero.webp
!public/assets/img/card-work-with-us.webp
!public/assets/img/card-careers.webp
!public/assets/img/card-partner.webp
!public/assets/img/hero-ai-company-poster.webp
!public/assets/img/hero-intelligent-automation-poster.webp
!public/assets/img/ai-native-automation.webp
!public/assets/img/services-hero.webp
# These twelve were used by the site but missing from this list, so every
# deploy until 2026-09-15 shipped them from a local disk and the repo alone
# could not build the site. None is refetchable.
!public/assets/img/about-hero-human-machine.webp
!public/assets/img/foundation-people-together.webp
!public/assets/img/objective-ai-innovation.webp
!public/assets/img/objective-customer-growth.webp
!public/assets/img/objective-global-expansion.webp
!public/assets/img/objective-intelligent-automation.webp
!public/assets/img/objective-scalable-products.webp
!public/assets/img/objectives-automation-hud.webp
!public/assets/img/story-education-project.webp
!public/assets/img/story-jio-telecom.webp
!public/assets/img/values-customer-satisfaction.webp
!public/assets/img/vision-mission-target.webp
# The internship band's picture, supplied by Vamscore 2026-09-15.
!public/assets/img/internship-band.webp
# Supplied video, plus the poster above that was captured from its first frame.
# video/ needs its own ladder for the same reason logos/ does: git will not
# descend into an excluded directory. The two Kyndryl clips beside it stay
# ignored — they are refetchable, this one is not.
!public/assets/video/
public/assets/video/*
!public/assets/video/hero-ai-company.mp4
!public/assets/video/hero-intelligent-automation.mp4
# The logo. Under logos/ rather than img/, so it needs its own ladder.
!public/assets/logos/
public/assets/logos/*
!public/assets/logos/vamscore.webp
# The square mark (browser icons, structured-data logo) and the partner marks
# supplied by Vamscore.
!public/assets/logos/vamscore-mark.png
!public/assets/logos/partner-greycells18.webp
!public/assets/logos/partner-jio.webp
!public/assets/logos/partner-tata.webp

# job applications — personal data (CVs, contact details), never commit
applications/
