# Employee login (Clerk) — copy this file to `.env.local` and fill it in.
#
# `.env.local` is gitignored. This template is the exception (see .gitignore),
# so it must never contain a real value.
#
# Without these, the site runs exactly as it does today: no login link, and
# /portal, /sign-in and /sign-up return 404. Nothing else changes.

# From Clerk dashboard → API keys. Safe to expose: it ships in the browser
# bundle by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me

# From the same page. SECRET — server-side only.
#
#   * Never put this in a NEXT_PUBLIC_* variable. Anything prefixed
#     NEXT_PUBLIC_ is compiled into the JavaScript every visitor downloads,
#     and a leaked Clerk secret key is full account compromise.
#   * Never paste it into a chat, an issue, or a commit.
CLERK_SECRET_KEY=sk_test_replace-me

# Where Clerk's own flows live in this app. `auth.protect()` reads
# CLERK_SIGN_IN_URL to know where to send an unauthenticated visitor.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after signing in or accepting an invitation. These are the
# current names — the older AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL were removed.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal

# Note on environments: pk_test_/sk_test_ keys work on any domain and must
# never reach production. Production needs a separate Clerk production
# instance with its own pk_live_/sk_live_ pair and a configured domain.

# --- Contact form (Resend) ----------------------------------------------------
#
# Without these the contact page still renders, but submitting returns a clear
# error telling the visitor to email you instead — never a silent failure that
# makes them think they got through.
#
# 1. Sign up at resend.com (free tier is plenty)
# 2. API Keys -> Create -> copy it below
# 3. Restart the dev server

# SECRET. Server-side only, never NEXT_PUBLIC_, never pasted into a chat.
RESEND_API_KEY=

# Where enquiries land.
CONTACT_TO_EMAIL=

# Who they appear to come from. Until you verify a domain in Resend, leave this
# as the shared sandbox address — with it, Resend will only deliver to the
# address that owns the Resend account.
CONTACT_FROM_EMAIL=onboarding@resend.dev
